# SecureAgent AI — Environment Configuration Example
# Copy this file to .env for local adjustments (never commit private secrets)

ENVIRONMENT=development
APP_NAME="SecureAgent AI"
APP_VERSION=1.0.0

# Server Binding
HOST=127.0.0.1
PORT=8000

# Model Execution Mode: deterministic | ollama | ibm_z_enclave
DEFAULT_MODEL_MODE=deterministic

# Optional Local Ollama Endpoint (Only needed if DEFAULT_MODEL_MODE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Hardware Simulation Mode (Set false only on genuine s390x hardware with CPACF/CEX)
IBM_Z_EMULATION_MODE=true

# Tamper-Evident Ledger Hashing
ENABLE_TAMPER_EVIDENT_HASHING=true
